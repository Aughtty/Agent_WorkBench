# MVP 离线模式无需 API Key。
# 第二阶段接入 OpenAI-compatible 模型时使用以下配置。
LLM_CHAT_URL=https://ai.tju.edu.cn/api/agent2026/你的专用端点/chat/completions
LLM_API_KEY=请替换为你自己的密钥
LLM_MODEL=tju-llm
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 只允许文件搜索工具访问这个目录，避免 Agent 扫描整块磁盘。
WORKSPACE_ROOT=./workspace
DATABASE_PATH=./data/workbench.db
LOG_PATH=./logs/agent.jsonl
